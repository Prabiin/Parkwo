# Reverse proxy with automatic HTTPS (Let's Encrypt). Domains come from .env.
# The mobile team talks to these three hosts; nothing else needs a public port.

{$API_DOMAIN} {
	reverse_proxy api:8080
}

{$MINIO_DOMAIN} {
	reverse_proxy minio:9000
}

{$MINIO_CONSOLE_DOMAIN} {
	reverse_proxy minio:9001
}
