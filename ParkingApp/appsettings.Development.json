{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=parkingapp;Username=parkingapp_user;Password=parkingapp_password"
  },
  "Jwt": {
    "Secret": "ParkingApp-Dev-Secret-Key-Change-In-Production-Must-Be-At-Least-32-Chars",
    "Issuer": "ParkingApp",
    "Audience": "ParkingApp.Mobile",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 30
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "admin",
    "SecretKey": "admin12345",
    "Bucket": "parkingapp",
    "UseSsl": false,
    "PublicBaseUrl": "http://localhost:9000"
  },
  "Upload": {
    "MaxImageSizeInMB": 5,
    "AllowedImageTypes": ["jpg", "jpeg", "png"]
  },
  "Otp": {
    "ExposeDevCode": true
  },
  "ParkingStandards": {
    "TwoWheelerAreaSqM": 2,
    "FourWheelerAreaSqM": 12.5
  },
  "Pass": {
    "SigningKey": "ParkingApp-Dev-Pass-Signing-Key-Change-In-Production-32-Chars",
    "EarlyEntryGraceMinutes": 15,
    "LateEntryGraceMinutes": 30,
    "OverstayGraceMinutes": 10
  },
  "Khalti": {
    "SecretKey": "",
    "PublicKey": "",
    "BaseUrl": "https://dev.khalti.com/api/v2/",
    "ReturnUrl": "https://api.example.com/payments/khalti/return",
    "WebsiteUrl": "https://parkwo.example.com"
  },
  "Elastic": {
    "Url": "http://localhost:9200"
  }
}
