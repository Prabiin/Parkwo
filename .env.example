# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
API_DOMAIN=api.parkwo.example.com
MINIO_DOMAIN=files.parkwo.example.com
MINIO_CONSOLE_DOMAIN=minio.parkwo.example.com
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
POSTGRES_PASSWORD=replace-with-a-strong-db-password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password

# Khalti ePayment v2 (parking checkout). Leave KHALTI_SECRET_KEY empty to keep
# payments disabled — the API still boots and every other feature works.
# Production BaseUrl is https://a.khalti.com/api/v2/ (sandbox: dev.khalti.com).
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/
KHALTI_RETURN_URL=https://api.parkwo.example.com/payments/khalti/return
KHALTI_WEBSITE_URL=https://parkwo.example.com

# Gate pass signing key. Optional: leave empty and the API boots with passes
# switched off (they answer "not configured") until one is set. Generate with:
#   openssl rand -base64 48
# On Render set the same value as Pass__SigningKey in the service Environment tab.
PASS_SIGNING_KEY=replace-with-a-long-random-signing-key
PASS_EARLY_ENTRY_GRACE_MINUTES=15
PASS_LATE_ENTRY_GRACE_MINUTES=30
PASS_OVERSTAY_GRACE_MINUTES=10
